#!/bin/sh /etc/rc.common
# 一点守护服务
START=99
STOP=10
USE_PROCD=1
PROG=/usr/sbin/doti

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
	# 门铃：订阅云端的门铃，响了让管控程序马上去同步；断了自己重连
	procd_open_instance bell
	procd_set_param command "$PROG" bell
	procd_set_param respawn 3600 30 0
	procd_close_instance
	# 升级程序没装就在后台补装（包里带着；失败原因写系统日志，管控程序之后每 6 小时再试）；
	# 关掉继承来的 procd 锁（fd 1000），不然补装期间 enable、restart 都要排队等它
	[ -x /usr/sbin/doti-update ] || /usr/libexec/doti/updater-fix >/dev/null 2>&1 </dev/null 1000>&- &
	[ -x /usr/sbin/dnsmasq ] || return 0
	# 每个孩子网络一个屏蔽名单 DNS（k1/k2/k3 → 5390/5391/5392），各读各的 block-kN.conf，由主程序写
	mkdir -p /tmp/doti /var/etc
	local k p=5390
	for k in k1 k2 k3; do
		[ -f /tmp/doti/block-$k.conf ] || : > /tmp/doti/block-$k.conf
		printf 'port=%s\nno-resolv\nserver=127.0.0.1#53\nno-hosts\nno-poll\ncache-size=300\nconf-file=/tmp/doti/block-%s.conf\n' $p $k > /var/etc/doti-dns-$k.conf
		procd_open_instance dns-$k
		procd_set_param command /usr/sbin/dnsmasq -k -C /var/etc/doti-dns-$k.conf -x /var/run/doti-dns-$k.pid
		procd_set_param respawn 3600 3 0
		procd_close_instance
		p=$((p + 1))
	done
}

stop_service() {
	killall mosquitto_sub 2>/dev/null   # 门铃的订阅进程（procd 只停 doti bell 本身）
	"$PROG" stop
}
