const log = logger('doti');
function exists(f) { return fs.stat(f) != null; }
let vclock = getenv('DOTI_LOOPS') ? +(getenv('DOTI_VSTART') ?? 1000) : null, loops = +(getenv('DOTI_LOOPS') ?? 0);
function mono() { if (vclock != null) return vclock; const u = fs.readfile('/proc/uptime'); return u ? +split(u, ' ')[0] : time(); }
function now() { return getenv('DOTI_NOW') ? +getenv('DOTI_NOW') + (vclock != null ? vclock - 1000 : 0) : time(); }
const ACC = accountMake({ store: { etc, readJson, writeJson, withLock }, verify, hmac: hmacSha256, bumpGen, now, log });
const OPS = opsMake({ settings: { defaults: settingsDefaults, merge: settingsMerge }, store: { etc, readJson, withLock, writeJson },
	wifi: { apply: wifiApply, bins: wifiBins, cmdsDisabled, cmdsKey, cmdsParent, adminSsid, parentTargets, parentIfaces, validPassword, ifacesOf, kidNet, load: wifiLoad, state: wifiState },
	root: pw => rootFollow(pw, sha256), sha: sha256, now, bumpGen,
	parents: { empty: emptyList, indexOf: listIndex, setProfile, cleanNick: x => cleanText(x, NAME_MAX), cleanAvatar } });

// ---------- 身份 ----------
// 身份写不进闪存（空间满、只读）时记成 unsaved：先不登记，免得每次启动换一个身份、云端多出一堆假设备；之后每圈再试着写
function newIdentity() {
	const id = { id: hexRand(16), key: hexRand(32), code: uc(hexRand(2)), registered: false };
	if (!writeSecret(etc('identity.json'), id)) { id.unsaved = true; log('设备身份写不进闪存（空间满了？），先不登记'); }
	log('生成设备身份，编号 ' + id.code);
	return id;
}
// 出厂 MAC（硬件指纹，重刷不变）：按顺序取第一个像样的——标签 MAC、eth0、开机时从出厂分区读出写进 board.json 的 LAN / WAN 口 MAC、第一块无线芯片的 MAC。
// 随机生成的（本地管理位为 1）、全 0 的不算：很多新机型 eth0 是随机的，真实 MAC 由系统脚本从出厂分区读出再设置
function goodMac(m) {
	m = lc(trim(m ?? ''));
	if (!match(m, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/) || m == '00:00:00:00:00:00') return null;
	return index('2367abef', substr(m, 1, 1)) >= 0 ? null : m;
}
function factoryMac() {
	let b = null;
	try { b = json(fs.readfile(cfg.board) ?? '{}'); } catch (e) { b = null; }
	for (let m in [b?.system?.label_macaddr, fs.readfile(cfg.sysnet + '/eth0/address'), b?.network?.lan?.macaddr, b?.network?.wan?.macaddr, fs.readfile(cfg.sysphy + '/phy0/macaddress')]) {
		const g = goodMac(m);
		if (g) return g;
	}
	return null;
}
// 运行中不会变：取一次
let hwMemo = null;
function hwHash() { if (hwMemo == null) { const m = factoryMac(); hwMemo = m ? sha256('doti-mac|' + m) : ''; } return hwMemo; }
// 身份文件坏了（读出来不是完整身份）：留一份 identity.json.bad 方便排查，再生成新身份
function identity() {
	const id = readJson(etc('identity.json'), null);
	if (type(id?.id) == 'string' && type(id?.key) == 'string' && type(id?.code) == 'string' && id.id && id.key && id.code) return id;
	if (exists(etc('identity.json'))) { fs.rename(etc('identity.json'), etc('identity.json.bad')); log('设备身份文件坏了，已改名 identity.json.bad，重新生成'); }
	return newIdentity();
}

// ---------- 配置 ----------
function nets() { return readJson(etc('nets.json'), []); }
function loadConf(id) {
	const ns = nets(), keys = map(ns, n => n.key);
	let s = readJson(etc('settings.json'), null);
	if (!s) { s = settingsDefaults(keys, id.code); writeJson(etc('settings.json'), s); }
	return { nets: ns, settings: s, today: readJson(etc('today.json'), null) ?? { seq: 0, plans: {} },
		member: readJson(etc('member.json'), null), parents: readJson(etc('parents.json'), null) };
}
function netSettings(c, key) { for (let n in c.settings.networks) if (n.key == key) return n; return null; }

// 局域网地址
function writeAddr(c) {
	const a = { lan: lanAddr(sh(cfg.uci + ' -q get network.lan.ipaddr 2>/dev/null'), sh(cfg.uci + ' -q get network.lan.netmask 2>/dev/null')),
		kids: map(c.nets, n => ({ key: n.key, ip: n.ip, prefix: 24 })) };
	writeJson(tmp('addr.json'), a);
}

function wanUp() {
	const s = sh('ifstatus wan 2>/dev/null');
	if (!s) return true;
	try { return json(s).up != false; } catch (e) { return true; }
}

// ---------- 采样 ----------
function snapshot(ns) {
	const text = listJSON(cfg.nft);
	const sta = {};
	for (let ifc in split(sh(cfg.iw + " dev 2>/dev/null | awk '/Interface/{print $2}'"), '\n'))
		if (ifc) { const x = parseStations(sh(sprintf('%s dev %s station dump 2>/dev/null', cfg.iw, ifc))); for (let mac in keys(x)) sta[mac] = x[mac]; }
	return { text, sets: parseSets(text, ns), ct: parseConntrack(fs.readfile(cfg.conntrack), prefixes(ns)), sta, leases: parseLeases(fs.readfile(cfg.leases)), ready: true };
}

// ---------- 运行时状态 ----------
let lastSnap = null, st = {}, prev = {}, lastTick = null, limitKey = null, limitFail = null, lastLimit = 0, ticks = 0;
let det = null, snapPrev = null, ctState = { seen: {} }, limitedNow = {}, lastBaseSave = 0, dropPrev = {};
let busy = {}, busyHit = {}, busyMiss = {}, want = {}, seg = {};
let usage = null, usageDay = '', usageHour = -1, stateHour = -1, lastStatus = null, trend = {};
let rrmAt = 0, wifiKey = null, baseKey = null, freeIps = [];
let blkConf = null, blkKey = null, blkStat = null;
// 状态变化记录：每个网络上一步的样子（换一天清空），刚开机的第一步记「路由器重启」
let evMem = {}, evDay = '', evBoot = +(split(fs.readfile('/proc/uptime') ?? '0', ' ')[0]) < 300 ? 'reboot' : 'restart';

// 不限速地址（可以几个）：孩子网络访问它们不限速、不计时。现在是云端自己（要时间、拍照上传、看家长的回应），以后需要放开的别的地址
// 也在里面。云端在每个回包里带上（freeIps），不另外解析域名；记在 /etc/doti/free-ips（一行一个，变了才写），开机先用它。
// 没收到过就不放行；变了统计表、限速表下一圈重新下发
function cloudHost() { const m = match(cloudUrl() ?? '', /^https?:\/\/([^\/:]+)/); return m ? m[1] : null; }
const ipKey = () => join(',', freeIps);
function freeIpsSeen(r) {
	const l = freeIpList(r);
	if (!length(l) || join(',', l) == ipKey()) return;
	freeIps = l;
	writeText(etc('free-ips'), join('\n', l) + '\n');
	log('不限速地址 ' + join(' ', l) + '：孩子网络访问它们不限速、不计时');
}

// 设置里没带这个开关的按默认（关）
function lanFreeOf(ns) { return !!(ns?.lanFree ?? LAN_FREE_DEFAULT); }

// 统计表：打开「家里局域网不计时、不限速」的网络只统计和内网以外的流量；设置变了重新下发
function baseApply(c) {
	const gs = map(c.nets, n => ({ ...n, lanFree: lanFreeOf(netSettings(c, n.key)) }));
	const k = join(',', map(gs, g => g.key + (g.lanFree ? '+lan' : ''))) + '|' + ipKey();
	if (k == baseKey) return;
	if (nftApply(cfg.nft, tmp('base.nft'), baseRuleset(gs, freeIps)) != 0) return log('统计规则下发失败，见 ' + tmp('base.nft'));
	if (baseKey != null) log('统计规则更新：' + k);
	baseKey = k;
}

function busyStep(key, limited, sig) {
	if (sig) { busyHit[key] = (busyHit[key] ?? 0) + 1; busyMiss[key] = 0; }
	else { busyMiss[key] = (busyMiss[key] ?? 0) + 1; busyHit[key] = 0; }
	if (!busy[key] && busyHit[key] >= WANT_ON) busy[key] = true;
	else if (busy[key] && busyMiss[key] >= WANT_OFF) busy[key] = false;
	want[key] = limited && !!busy[key];
}

// 这一段的开始时刻和下次切换
function segFor(o, t, inUse) {
	const k = segOf(o), nx = nextOf(o, t, inUse);
	let s = seg[o.key];
	if (!s || s.k != k) s = seg[o.key] = { k, since: t, next: nx };
	else if (nx == null || s.next == null || nx > s.next + SEG_JITTER || nx < s.next - SEG_JITTER) s.next = nx;
	return s;
}

// 存当天的上网记录（每小时、换天时）；顺手把当天的计数记进 autocount.json（最近 3 天），报到时带上——没绑定、服务期外不交上网记录的路由器也能看出用得多不多
function usageSave() {
	if (!usage || !usageDay) return;
	writeJson(etc('usage/' + usageDay + '.json'), usage);
	try { writeJson(etc('autocount.json'), countsKeep(readJson(etc('autocount.json'), {}), usageDay, usageCounts(usage), 3)); }
	catch (e) { log('当天计数没记上：' + e); }
}
function usageRoll(day, hour) {
	if (day != usageDay) {
		usageSave();
		usageDay = day;
		usage = readJson(etc('usage/' + day + '.json'), {});
		for (let f in usageExpired(fs.lsdir(etc('usage')) ?? [], day)) fs.unlink(etc('usage/' + f));
	}
	else if (hour != usageHour && usageHour >= 0) usageSave();
	usageHour = hour;
}

// 每个孩子网络一个屏蔽 DNS（每个孩子网络各自开哪些屏蔽分类、关掉哪些自己加的网站）：k1/k2/k3 → 端口 5390/5391/5392，配置 block-k1.conf …，pid 文件 doti-dns-k1.pid …
function dnsPort(key) { return cfg.dnsPort + index(NET_KEYS, key); }
function dnsPidFile(key) { return replace(cfg.dnsPid, /\.pid$/, '-' + key + '.pid'); }
function dnsAlive(key) {
	const pid = +(fs.readfile(dnsPidFile(key)) ?? 0);
	if (pid <= 0) return false;
	// 每圈都查三次：看 /proc 不起进程；没有 /proc（测试机）才用 kill -0
	return fs.stat('/proc/self') ? fs.stat('/proc/' + pid) != null : system(sprintf('kill -0 %d 2>/dev/null', pid)) == 0;
}
function blockTick(c) {
	const d = blockDir(etc('blocklist'), readJson(etc('blocklist/manifest.json'), null), cfg.blocklist, readJson(cfg.blocklist + '/manifest.json', null));
	const custom = filter(map(c.settings.block?.custom ?? [], cleanDomain), x => x);
	const texts = {};
	for (let k in NET_KEYS) texts[k] = blockMain(d[0], d[1], custom, netSettings(c, k)?.block);
	const all = join('\n---\n', map(NET_KEYS, k => texts[k]));
	if (all != blkConf) {
		let changed = false;
		for (let k in NET_KEYS) if (fs.readfile(tmp('block-' + k + '.conf')) != texts[k]) {
			writeText(tmp('block-' + k + '.conf'), texts[k]);
			const pid = +(fs.readfile(dnsPidFile(k)) ?? 0);
			if (pid > 0) system(sprintf('kill %d 2>/dev/null', pid));   // procd 马上重启它，读新配置
			changed = true;
		}
		if (changed) log('屏蔽名单更新：v' + (d[1]?.ver ?? 0) + '，' + join(' ', map(c.settings.networks ?? [], n => n.key + ':' + join('/', n.block?.categories ?? []) + (length(n.block?.off ?? []) ? '(关 ' + length(n.block.off) + ')' : ''))) + '，自定义 ' + length(custom));
		blkConf = all;
	}
	// 只转在跑的那几个网络；某个网络的屏蔽 DNS 没在跑，这个网络先用系统 DNS
	const ports = {}, devs = [];
	for (let n in c.nets) if (index(NET_KEYS, n.key) >= 0 && dnsAlive(n.key)) { push(devs, n.dev); ports[n.dev] = dnsPort(n.key); }
	sort(devs);
	// 拦加密 DNS 的网络（家长打开了「拦截加密 DNS」，即 allowDoh 为假）；默认放行，DNS 照样走屏蔽名单
	const guard = filter(devs, x => { for (let n in c.nets) if (n.dev == x) return !(netSettings(c, n.key)?.allowDoh ?? ALLOW_DOH_DEFAULT); return false; });
	const key = join(',', map(devs, x => x + ':' + ports[x])) + '|' + join(',', guard);
	if (key != blkKey && nftApply(cfg.nft, tmp('dns.nft'), dnsRuleset(devs, ports, DOH_IPS, guard)) == 0) {
		if (blkKey != null || length(devs)) log(length(devs) ? '孩子网络 DNS 转到屏蔽名单：' + join(' ', devs) : '屏蔽名单的 DNS 没在跑，孩子网络先用系统 DNS');
		blkKey = key;
	}
	blkStat = { on: length(devs) > 0, ver: d[1]?.ver ?? 0, n: blockCounts(d[1], custom) };
}

function windowOf(ns, name) {
	for (let w in ns.windows) if (w.name == name) return { days: w.days, start: w.start, end: w.end };
	return null;
}

// 这个版本第一次跑起来的时间：版本变了、时钟对过了才记，没装过升级程序的新装路由器也有「更新时间」
function installedAt() {
	const r = readJson(etc('installed.json'), null);
	if (r?.version == VERSION) return r.at;
	if (!exists(tmp('clock'))) return null;
	const t = now();
	writeJson(etc('installed.json'), { version: VERSION, at: t });
	return t;
}

// 家长 WiFi 设没设密码：要读一遍无线配置（起 uci 进程），每圈都报但很少变，配置变了（gen）或过了 60 秒才重读
let pwSetCache = null;
function parentPwSet(code) {
	const m = mono(), g = gen();
	if (pwSetCache && pwSetCache.g == g && m - pwSetCache.at < 60) return pwSetCache.v;
	pwSetCache = { g, at: m, v: parentHasPassword(wifiLoad(wifiBins()), code) };
	return pwSetCache.v;
}
// 快照里的 WiFi 段：各孩子 WiFi 的名字和开关、家长 WiFi 名和设没设密码（不带密码）；名字、密码状态和 parentPwSet 一样缓存
let wifiNameCache = null;
function wifiView(code, nets, on) {
	const m = mono(), g = gen();
	if (!wifiNameCache || wifiNameCache.g != g || m - wifiNameCache.at >= 60) {
		const o = wifiLoad(wifiBins()), names = {};
		for (let n in nets) names[n.key] = ifacesOf(o, kidNet(n.key))[0]?.ssid ?? '';
		wifiNameCache = { g, at: m, names };
	}
	return { kids: map(nets, n => ({ key: n.key, ssid: wifiNameCache.names[n.key] ?? '', on: on ? !!on[n.key] : null })),
		parent: { ssid: adminSsid(code), set: parentPwSet(code) } };
}
// 最近一次报到（升级程序报的，或没装升级程序时主程序自己报的，取晚的）和上次升级结果
function updRecords() {
	const a = readJson(cfg.updDir + '/checkin.json', null), b = readJson(etc('checkin.json'), null);
	return { ck: (b?.at ?? 0) > (a?.at ?? 0) ? b : a, up: readJson(cfg.updDir + '/last.json', null) };
}
function routerStatus(id, c) {
	const u = updRecords(), ck = u.ck, up = u.up;
	const upd = max(installedAt() ?? 0, up?.at ?? 0);
	return { code: id.code, name: c.settings.routerName, version: VERSION, wan: wanUp(), registered: !!id.registered,
		...(ck?.at ? { lastCheckin: ck.at } : {}), ...(upd ? { upgradedAt: upd } : {}),
		...(c.member?.x ? { member: c.member.x } : {}),
		parentWifiPassword: parentPwSet(id.code), clockSynced: exists(tmp('clock')) };
}

function saveBaseline() {
	if (!det) return;
	writeJson(etc('baseline.json'), detSave(det, now()));
	det.dirty = false;
	lastBaseSave = mono();
}

// ---------- 管控一步 ----------
// ---------- 每 TICK 秒一圈（tick）：拆成几步 ----------
// 跨天：删掉不是今天的临时安排（内存里的和 today.json 里的）
function todayPrune(c, day, t) {
	let changed = false;
	for (let k in keys(c.today.plans)) if (c.today.plans[k].date != day) { delete c.today.plans[k]; changed = true; }
	if (changed) withLock(() => {
		const cur = readJson(etc('today.json'), null) ?? { seq: 0, plans: {} };
		for (let k in keys(cur.plans)) if (cur.plans[k].date != day) delete cur.plans[k];
		writeJson(etc('today.json'), cur);
	}, t);
}
// 采样和用网判定：各网络的计数（cnt）、按设备判定出的在用网络（active，判定不了为 null）、每台设备这一步的在用和流量（devUse）
function sample(c, m, t, lt, dt) {
	const snap = snapshot(c.nets);
	// 家里局域网不计时：这些网络访问内网的连接不进用网判定
	const lanNets = filter(c.nets, n => lanFreeOf(netSettings(c, n.key)));
	if (length(lanNets)) {
		const pf = prefixes(lanNets);
		for (let k in keys(snap.ct)) { const f = snap.ct[k]; if (isPrivate(f.dst) && length(filter(pf, p => index(f.src, p) == 0))) delete snap.ct[k]; }
	}
	const cnt = parseCounters(snap.text);
	let active = null, devUse = null;
	if (dt > 0 && snapPrev?.ready && length(keys(snap.sets))) {
		const learn = {};
		for (let n in c.nets) learn[n.key] = !!limitedNow[n.key] || lt.hour < 6;
		const devf = features(snapPrev, snap, dt, int(m), ctState);
		for (let ip in keys(devf)) {
			const f = devf[ip];
			if (!f.net) for (let n in c.nets) if (index(ip, prefixes([n])[0]) == 0) f.net = n.key;
		}
		const r = detStep(det, devf, dt, t, { learn });
		active = r.groups;
		devUse = {};
		for (let ip, f in devf) {
			if (!f.mac || !f.net) continue;
			const u = (devUse[f.net] ??= {})[f.mac] ??= { on: !!r.devs[f.mac]?.on, d: 0, u: 0 };
			u.d += f.dn_b; u.u += f.up_b;
		}
		for (let mac, x in r.devs) {
			if (x.on && x.net) (devUse[x.net] ??= {})[mac] ??= { on: true, d: 0, u: 0 };
			x.host = det.base[mac]?.host ?? '';
		}
		writeJson(tmp('devices.json'), r.devs);
	}
	snapPrev = snap;
	return { cnt, active, devUse };
}
// 孩子 WiFi 实际开着哪些（读不到为 null）；开关变了 15 秒后重排 802.11k 邻居
function wifiNow(c, m) {
	const on = wifiState(wifiBins(), map(c.nets, n => n.key));
	if (on) {
		const wk = join(',', filter(map(c.nets, n => n.key), k => on[k]));
		if (wifiKey != null && wk != wifiKey) rrmAt = m + 15;
		wifiKey = wk;
	}
	return on;
}
// 一个孩子网络这一步：网速、状态机、要网、上网记录、状态变化，回 { key, dev, limited, kbps, lanFree, net（上报的网络状态）}
function netStep(n, ns, x) {
	const k = n.key, dt = x.dt, t = x.t, lt = x.lt, on = x.on;
	const cur = x.cnt[k] ?? { bytes: 0, pkts: 0, up: 0, dn: 0 }, p = prev[k];
	const okc = p && dt > 0 && cur.bytes >= p.bytes;
	const db = okc ? cur.bytes - p.bytes : 0, dp = okc && cur.pkts >= p.pkts ? cur.pkts - p.pkts : 0;
	const dup = okc ? max(0, cur.up - p.up) : 0, ddn = okc ? max(0, cur.dn - p.dn) : 0;
	let speed = null;
	if (okc) { speed = { down: int(ddn / dt), up: int(dup / dt) }; trendPush(trend, k, speed.down, speed.up, TREND_N); }
	prev[k] = cur;
	const inUse = x.active ? !!x.active[k] : classify(db, dp, dt) != 'idle';
	const r = ctlStep(toEngine(ns), st[k], x.c.today.plans[k], { now: t, lt, today: x.day, dt, inUse });
	st[k] = r[0];
	const o = r[1];
	const dr = x.drops[k] ?? 0, dd = dr >= (dropPrev[k] ?? 0) ? dr - (dropPrev[k] ?? 0) : dr;
	dropPrev[k] = dr;
	if (dt > 0) {
		busyStep(k, o.limited, dd > 0 || inUse);
		usageAdd(usage, k, lt.hour, o.limited, inUse ? dt : 0, ddn / 1024.0, dup / 1024.0, x.devUse?.[k]);
	}
	const sg = segFor(o, t, !!busy[k]);
	// 临时开放到点后 today.json 里还留着这条安排（当天有效），状态里只报还在生效的
	const p0 = x.c.today.plans[k], plan = p0 && (p0.action != 'open' || p0.until > t) ? p0 : null;
	const period = on && !on[k] ? 'wifiOff' : o.period;
	const er = evStep(evMem[k], { period, periodName: o.periodName, remainSec: o.remainSec, next: sg.next,
		plan: p0, planOn: !!plan, inUse, wifiOn: on ? !!on[k] : null, ver: ns.ver, rules: ns, who: x.who[k], cancel: x.c.today.cancel?.[k], boot: evBoot }, t);
	evMem[k] = er[0];
	if (usage) evAppend(usage, k, er[1]);
	return { key: k, dev: n.dev, limited: o.limited, kbps: ns.limitKbps ?? LIMIT_KBPS, lanFree: lanFreeOf(ns), net: {
		key: k, name: ns.name, wifiOn: on ? !!on[k] : null,
		period, periodName: o.periodName,
		since: sg.since, ...(sg.next ? { next: sg.next } : {}),
		remainSec: o.remainSec, surfMin: ns.surfMin, limitMin: ns.limitMin, dailyMaxMin: ns.dailyMaxMin,
		usedMinToday: int(o.usedSec / 60), onlineMinToday: onlineMin(usage, k), limitKbps: ns.limitKbps ?? LIMIT_KBPS, want: !!want[k],
		...(o.period == 'fixedOpen' || o.period == 'fixedLimit' ? { window: windowOf(ns, o.periodName) } : {}),
		...(plan ? { plan } : {}), ...(speed ? { speed } : {}) } };
}
// 限速规则：限速中的网络变了（或到了定期重下的时候）才重下
function limitApply(outs, m) {
	const lim = map(filter(outs, o => o.limited), o => ({ key: o.key, dev: o.dev, kbps: o.kbps, lanFree: o.lanFree }));
	const key = join(',', sort(map(lim, x => x.dev + '@' + x.kbps + (x.lanFree ? '+lan' : '')))) + '|' + ipKey();
	if (key == limitKey && m - lastLimit < REAPPLY) return;
	if (nftApply(cfg.nft, tmp('limit.nft'), limitRuleset(lim, freeIps)) == 0) {
		if (key != limitKey) log('限速网络：' + (join(' ', map(lim, x => x.key)) || '无'));
		limitKey = key; lastLimit = m;
	}
	else if (key != limitFail) { log('限速规则下发失败，见 ' + tmp('limit.nft')); limitFail = key; }
}
// 写这一圈的结果：状态机（内存盘每圈、闪存每小时）、今天的上网记录、网速曲线、状态（局域网接口、远程同步读它）
function persist(id, c, outs, t, lt, on) {
	writeJson(tmp('state.json'), st);
	if (lt.hour != stateHour) { if (stateHour >= 0) writeJson(etc('state.json'), st); stateHour = lt.hour; }
	writeJson(tmp('usage-now.json'), usage);
	writeJson(tmp('trend.json'), { step: TICK, nets: trend });
	lastStatus = { at: t, router: routerStatus(id, c), networks: map(outs, o => o.net), block: blkStat };
	writeJson(tmp('status.json'), lastStatus);
	// 快照（局域网 GET /doti/snapshot、远程同步都用它）
	// 路由器段带各 WiFi 密码改动时间（只有时间，家长手机据此判断自己记的密码是不是旧的）
	const pwAt = OPS.pwAtOf(), ss = { ...lastStatus, router: { ...lastStatus.router, ...(length(keys(pwAt)) ? { pwAt } : {}) } };
	lastSnap = snapshotOf(ss, c.settings, wifiView(id.code, c.nets, on), toPublic(c.parents ?? emptyList(), ''), keyState(lastStatus, c.settings, today(lt), pwAt));
	writeJson(tmp('snapshot.json'), lastSnap);
}

function tick(id, c) {
	const m = mono();
	const dt = lastTick == null ? 0 : min(DT_MAX, m - lastTick);
	lastTick = m;
	const t = now(), lt = localtime(t), day = today(lt);
	usageRoll(day, lt.hour);
	todayPrune(c, day, t);
	baseApply(c);
	const smp = sample(c, m, t, lt, dt);
	const drops = length(filter(keys(limitedNow), k => limitedNow[k])) ? parseDrops(listJSON(cfg.nft, NFT.limit)) : {};
	const on = wifiNow(c, m);
	if (day != evDay) { evMem = {}; evDay = day; }
	// 谁刚改了规则、开关了 WiFi（局域网接口写的，两分钟内有效）
	const x = { c, t, lt, day, dt, on, drops, cnt: smp.cnt, active: smp.active, devUse: smp.devUse, who: readJson(tmp('who.json'), null) ?? {} };
	const outs = [];
	for (let n in c.nets) { const ns = netSettings(c, n.key); if (ns) push(outs, netStep(n, ns, x)); }
	for (let o in outs) limitedNow[o.key] = o.limited;
	evBoot = null;
	blockTick(c);
	if (det?.dirty && m - lastBaseSave >= BASE_SAVE) saveBaseline();
	limitApply(outs, m);
	persist(id, c, outs, t, lt, on);
	ticks++;
	if (ticks == CONFIRM_TICKS) writeText(tmp('confirm'), VERSION);
}

// ---------- 802.11k 邻居 ----------
let rrmOwn = null;
function rrmSync() {
	if (rrmOwn == null) rrmOwn = readJson(tmp('rrm-own.json'), {});
	const live = {};
	let fresh = false;
	for (let x in split(sh(cfg.ubus + " list 'hostapd.*' 2>/dev/null"), '\n')) {
		x = trim(x);
		if (!match(x, /^hostapd\.[A-Za-z0-9_.-]+$/)) continue;
		let v = null;
		try { v = json(sh(cfg.ubus + ' call ' + x + ' rrm_nr_get_own 2>/dev/null'))?.value; } catch (e) { v = null; }
		if (type(v) == 'array' && length(v) >= 3) { if (sprintf('%J', rrmOwn[x]) != sprintf('%J', v)) fresh = true; rrmOwn[x] = v; }
		if (rrmOwn[x]) live[x] = rrmOwn[x];
	}
	if (fresh) writeJson(tmp('rrm-own.json'), rrmOwn);
	let paired = 0;
	for (let x in keys(live)) {
		const v = live[x], list = [];
		for (let y in keys(live)) if (live[y][1] == v[1]) push(list, live[y]);
		if (length(list) > 1) { sh(cfg.ubus + ' call ' + x + ' rrm_nr_set ' + shq(sprintf('%J', { list })) + ' >/dev/null 2>&1'); paired++; }
	}
	return paired > 0 || !length(live);
}

// ---------- 云端 ----------
const regRetry = { fails: 0, next: 0 }, ckRetry = { fails: 0, next: 0 };
let regLast = -100, bk = null;

// 云端没有这台的记录时重新登记
function lostRegistration(id) {
	if (!id.registered) return;
	id.registered = false;
	writeSecret(etc('identity.json'), id);
	if (bk) { bk.sentVer = 0; bk.dueAt = now(); writeJson(etc('backup.json'), bk); }
	regRetry.next = 0;
	log('云端没有这台的记录了，重新登记');
}

function clockFix(cloudNow) {
	if (type(cloudNow) != 'int' || (getenv('DOTI_NOW') && !getenv('DOTI_DATE'))) return;   // 测试用假时钟时，只有给了假 date 才走
	if (cloudNow - now() > CLOCK_FIX || now() - cloudNow > CLOCK_FIX) {
		system([cfg.date, '-s', '@' + cloudNow]);
		log('用云端时间校时');
	}
	writeJson(tmp('clock'), { src: 'cloud', at: cloudNow });
}
// 所有云端请求都经 call：有回包（不管成没成）就算连上了云端——记下时间（局域网接口据此判断离线）、按云端时间校时、
// 记下不限速地址；云端说没有这台的记录（NOT_REGISTERED）就重新登记。各处只管自己的业务结果
function cloudOk(r) {
	writeJson(tmp('cloud.json'), { lastOk: now() });
	clockFix(r?.now);
	freeIpsSeen(r);
}
function call(id, op, body) {
	const r = cloudPost(hmacSha256, id, op, now(), body, tmp());
	if (type(r) == 'object') cloudOk(r);
	if (r?.error == 'NOT_REGISTERED') lostRegistration(id);
	return r;
}

// 失败重试（LLD §2.11.2）：每种云端请求一个 { fails, next }；到了 next 才再试，失败按退避往后推，成功清零
function retryDue(t, m) { return m >= (t.next ?? 0); }
function retryFail(t, m, base, cap) { t.fails = (t.fails ?? 0) + 1; t.next = m + backoff(t.fails, base, cap); }
function retryOk(t) { t.fails = 0; t.next = 0; }

// 已装升级程序的版本：在用的那份副本，没有就看包里装的那份；都没有（没装上）回空串
function updaterVersion() {
	const act = trim(fs.readfile(cfg.updDir + '/active') ?? '');
	const uv = match((act ? fs.readfile(cfg.updDir + '/slot-' + act + '/doti-update.uc') : null) ?? fs.readfile(cfg.sys + '/usr/share/doti-updater/doti-update.uc') ?? '', /const VERSION = '([^']+)'/);
	return uv ? uv[1] : '';
}
// 登记带的系统信息：采集出任何错都只是不带，不影响登记（DOTI_ENV_FAIL 是测试用的，设了就让采集出异常）
function envSafe() {
	try {
		if (getenv('DOTI_ENV_FAIL')) die('DOTI_ENV_FAIL');
		return envCollect({ sys: cfg.sys, sh, ubus: cfg.ubus, overlay: cfg.overlay, pm: cfg.pm });
	} catch (e) {
		log('采集系统信息出错，这次登记不带：' + e);
		return null;
	}
}
// 换编号（只在登记时、还没绑定时）：家长 WiFi、孩子 WiFi 改成新编号的名字（密码、开关不动），默认路由器名跟着换
function recode(id, code) {
	const old = id.code;
	const r = withLock(() => {
		const b = wifiBins(), o = wifiLoad(b), cmds = [];
		for (let n in nets())
			for (let f in ifacesOf(o, kidNet(n.key))) if (f.ssid == kidSsid(old, n.key)) push(cmds, 'set wireless.' + f.sec + '.ssid=' + shq(kidSsid(code, n.key)));
		for (let f in filter(parentIfaces(o, old), x => x.ours)) push(cmds, 'set wireless.' + f.sec + '.ssid=' + shq(adminSsid(code)));
		for (let x in cmds) system(b.uci + ' ' + x);
		if (length(cmds)) { system(b.uci + ' commit wireless'); system('(sleep 2; ' + b.wifi + ' reload) >/dev/null 2>&1 &'); }
		const st = readJson(etc('settings.json'), null);
		if (st && st.routerName == defaultRouterName(old)) { st.routerName = defaultRouterName(code); writeJson(etc('settings.json'), st); }
		id.code = code;
		writeSecret(etc('identity.json'), id);
		return true;
	});
	if (r[1]) { log('换编号：拿不到锁，先用原编号'); return; }
	bumpGen();
	log('编号 ' + old + ' 已被别的路由器用了，换成 ' + code + '（WiFi 名跟着改）');
}

// 登记：带系统信息（env，给兼容性统计）和升级程序版本（updater，空串 = 没装上）。
// refresh：已登记的再登记一次补硬件指纹——这时云端说 ID 被占用也不换身份，只记日志
function register(id, refresh) {
	const hw = hwHash(), env = envSafe();
	let uv = '';
	try { uv = updaterVersion(); } catch (e) { uv = ''; }
	const r = call(id, 'register', { id: id.id, key: id.key, code: id.code, recode: true, model: trim(fs.readfile(cfg.sys + '/tmp/sysinfo/model') ?? ''),
		version: VERSION, ...(hw ? { macHash: hw } : {}), updater: uv, ...(env ? { env } : {}) });
	if (r?.ok) {
		// 编号被别的路由器用了：云端回一个没人用的，还没绑定就改用它（WiFi 名跟着改）；绑定后不改，家长已经认这个名字了
		if (!refresh && type(r.code) == 'string' && match(r.code, /^[0-9A-F]{4}$/) && r.code != id.code && !length(readJson(etc('parents.json'), null)?.parents ?? []))
			recode(id, r.code);
		id.registered = true;
		id.hw = hw;   // 登记时带的硬件指纹（空串 = 没取到）：以后取到了、或换了取法取到不一样的，再登记一次让云端补上
		writeSecret(etc('identity.json'), id);
		log('已在云端登记');
		return true;
	}
	if (r?.error == 'EXISTS' && !refresh) {
		id.id = hexRand(16); id.key = hexRand(32);
		writeSecret(etc('identity.json'), id);
		log('设备 ID 已被占用，换一个重新登记');
	}
	else log('登记没成功：' + (r?.error ? r.error + (r.msg ? '（' + r.msg + '）' : '') : '连不上云端或回包不对') + '，稍后再试');
	return false;
}

// 云端备份：只有路由器档案（名称 + 家长名单）；设置不上传，恢复由家长手机里缓存的备份做（同一台重刷时）
function bkLoad() { return bk ??= readJson(etc('backup.json'), null) ?? { ver: 0, sentVer: 0, pkey: '', dueAt: 0 }; }
function backupMark(id, c) {
	bkLoad();
	const pv = c.parents?.ver ?? 0, pkey = pv + '|' + c.settings.routerName;
	if (pkey == bk.pkey) return;
	bk.ver = max(bk.ver + 1, pv);
	bk.dueAt = now();
	bk.pkey = pkey;
	writeJson(etc('backup.json'), bk);
}
// 服务期凭证、远程管理总开关：account.uc（在家开通时局域网接口也写）
const remoteOn = ACC.remoteOn, remoteFlag = ACC.remoteFlag, memberDrop = ACC.memberDrop;
function memberSet(id, cred, opt) { if (cred) ACC.memberSet(id, cred, opt); }
// 门铃只在服务期内连（远程管理总开关开着、本地服务期凭证没到期）；服务期外不连，账号类动作靠每日报到、开机报到和孩子查看页的刷新
function bellWant() { return remoteOn() && (ACC.memberUntil() ?? 0) > now(); }
function backupUpload(id, c) {
	const ps = c.parents?.parents ?? [];
	if (!length(ps)) return;
	const list = sign(hmacSha256, id.key, { t: 'list', d: id.id, e: 0, ver: bk.ver, at: now(), name: c.settings.routerName,
		parents: map(ps, p => ({ o: p.o, nick: p.nick, avatar: p.avatar, by: p.by, at: p.at })) });
	const r = call(id, 'profile', { list });   // 上传路由器档案：名称 + 家长名单（云端 op 原名 backup）
	if (r?.ok) { bk.sentVer = bk.ver; retryOk(bk); writeJson(etc('backup.json'), bk); log('路由器档案已上传（v' + bk.ver + '）'); return; }
	if (r?.error == 'VERSION' && type(r.ver) == 'int') { bk.ver = r.ver + 1; writeJson(etc('backup.json'), bk); return; }
	if (r?.error == 'CLOCK') return;   // 已按云端时间校时，下一圈重试
	retryFail(bk, mono(), 60, 3600);
}

// 出厂默认 root 密码：预装时安装脚本写在 /etc/doti/preinstall 里（只有 root 能读；8 位以上才算，空标记只管网段）
function preinstallPw() { const p = trim(fs.readfile(etc('preinstall')) ?? ''); return length(p) >= 8 ? p : null; }
// 自己装的、没人绑定时，不用密码的家长 WiFi 开着那段时间 root 临时用的默认密码（公开的，安装脚本和说明里都写着）
const ROOT_TEMP_PW = 'Passwd4Doti';
function bound() { return length(readJson(etc('parents.json'), null)?.parents ?? []) > 0; }

// 认领限时：开机（或解除绑定）后不用密码的家长 WiFi 开 30 分钟
const CLAIM_OPEN = 1800;
function claimOpen(m) { return m < +(fs.readfile(tmp('claim-from')) ?? 0) + CLAIM_OPEN; }

// root 密码按现在的状态对齐（每 10 秒看一次，断电、重启后也一样）：
// 自己装的没人绑定：家长 WiFi 开放中 root 没设密码 → 临时默认密码；关闭后还是那个 → 恢复为空（rootpw.uc temp）；
// 预装的没人绑定：启动时 root 没设密码就设成出厂默认密码；
// 已绑定：root 是临时默认密码，或启动时 root 还没设密码（绑定在这个功能之前）→ 换成现在的家长 WiFi 密码
let rootFirst = true, rootNext = 0;
function rootStep(id) {
	const m = mono();
	if (m < rootNext) return;
	rootNext = m + 10;
	const first = rootFirst, dflt = preinstallPw();
	rootFirst = false;
	if (!bound()) {
		if (dflt) { if (first && rootInit(dflt, sha256) == 'set') log('预装：root 密码已设成出厂默认密码，绑定后换成家长 WiFi 密码'); return; }
		const r = rootTemp(claimOpen(m), ROOT_TEMP_PW, sha256);
		if (r == 'set') log('家长 WiFi 开放中：root 密码临时设成默认密码 ' + ROOT_TEMP_PW + '，关闭后恢复为空');
		else if (r == 'clear') log('家长 WiFi 已关闭：root 的临时默认密码已去掉，恢复为空');
		return;
	}
	const k = rootKind(sha256);
	if (k != 'temp' && !(first && k == 'empty')) return;
	const f = filter(parentIfaces(wifiLoad(wifiBins()), id.code), x => x.ours && x.enc != '' && x.enc != 'none' && length(x.key ?? '') >= 8)[0];
	if (f && rootFollow(f.key, sha256) == 'set') log('root 密码已设成家长 WiFi 密码');
}

let claimNext = 0;
// 绑定前诊断（没绑定时每 10 秒更新 /tmp/doti/prebind.json，升级程序报到时带上，帮着查「装好了绑不上」）：
// 家长 WiFi 起来没（无线状态里它有网卡）、开放还剩几分钟、开放期间连过家长 WiFi 的设备有几台（只数数量，不留 MAC）、
// 绑定请求来过几次、最近一次失败的错误码（局域网接口记在 claim-stats.json）
let pbSeen = {};
function prebindNote(b, ours, open, m) {
	let st = null;
	try { st = json(sh(b.ubus + ' call network.wireless status 2>/dev/null') || 'null'); } catch (e) { st = null; }
	const secs = map(ours, f => f.sec), ifs = [];
	if (type(st) == 'object')
		for (let r in keys(st)) for (let i in st[r]?.interfaces ?? []) if (index(secs, i?.section) >= 0 && i?.ifname) push(ifs, i.ifname);
	if (open) for (let ifc in ifs) for (let mac in keys(parseStations(sh(sprintf('%s dev %s station dump 2>/dev/null', cfg.iw, shq(ifc)))) ?? {})) pbSeen[mac] = true;
	const cs = readJson(tmp('claim-stats.json'), null), left = +(fs.readfile(tmp('claim-from')) ?? 0) + CLAIM_OPEN - m;
	writeJson(tmp('prebind.json'), { up: length(ifs) > 0, openMin: open && left > 0 ? int((left + 59) / 60) : 0, clients: length(keys(pbSeen)),
		claims: type(cs?.n) == 'int' ? cs.n : 0, err: type(cs?.err) == 'string' ? cs.err : '' });
}
function claimStep(id) {
	const m = mono();
	if (m < claimNext) return;
	claimNext = m + 10;
	const claimed = bound(), off = !!fs.stat(etc('temp-off'));
	if (claimed && exists(tmp('prebind.json'))) fs.unlink(tmp('prebind.json'));
	if (claimed && !off) return;
	const b = wifiBins(), ours = filter(parentIfaces(wifiLoad(b), id.code), f => f.ours);
	if (!claimed) { try { prebindNote(b, ours, claimOpen(m), m); } catch (e) { log('绑定前诊断没记上：' + e); } }
	if (claimed) {
		wifiApply(b, cmdsDisabled(ours, true));
		fs.unlink(etc('temp-off'));
		log('已认领，家长 WiFi 重新打开');
		return;
	}
	const temp = filter(ours, f => f.enc == '' || f.enc == 'none');   // 还没设密码的家长 WiFi
	if (!length(temp)) return;
	const open = claimOpen(m);
	if (open && off) {
		wifiApply(b, cmdsDisabled(temp, true));
		fs.unlink(etc('temp-off'));
		log('开机 30 分钟内，临时家长 WiFi 重新打开等认领');
	}
	else if (!open && !off && wifiApply(b, cmdsDisabled(temp, false))) {
		writeText(etc('temp-off'), '' + now());
		log('30 分钟没人认领，临时家长 WiFi 已关闭（断电重开路由器再开 30 分钟）');
	}
}

// 解除绑定并清除数据
function unbind(remote) {
	ensureDirs();
	const old = identity();
	if (!remote && old.registered) {
		const r = call(old, 'unbind', {});
		log(r?.ok ? '已通知云端删除备份' : '通知云端失败，照样清除本机数据');
	}
	const r = withLock(() => {
		for (let f in ['parents.json', 'today.json', 'member.json', 'cmds.json', 'baseline.json', 'state.json', 'identity.json', 'backup.json', 'devnames.json'])
			fs.unlink(etc(f));
		for (let f in (fs.lsdir(etc('usage')) ?? [])) fs.unlink(etc('usage/' + f));
		const id = newIdentity(), ns = nets();
		writeJson(etc('settings.json'), settingsDefaults(map(ns, n => n.key), id.code));
		const b = wifiBins(), o = wifiLoad(b), cmds = [];
		for (let n in ns) {
			const pw = randDigits(8);
			for (let f in ifacesOf(o, kidNet(n.key))) {
				push(cmds, 'set wireless.' + f.sec + '.disabled=1');
				push(cmds, 'set wireless.' + f.sec + '.ssid=' + shq(kidSsid(id.code, n.key)));
				push(cmds, 'set wireless.' + f.sec + '.key=' + shq(pw));
			}
		}
		for (let f in filter(parentIfaces(o, old.code), x => x.ours)) {
			push(cmds, 'set wireless.' + f.sec + '.ssid=' + shq(adminSsid(id.code)));   // 新编号的名字，不加密
			push(cmds, 'set wireless.' + f.sec + '.encryption=none');
			push(cmds, 'delete wireless.' + f.sec + '.key');
		}
		for (let x in cmds) system(b.uci + ' ' + x);
		system(b.uci + ' commit wireless');
		system('(sleep 2; ' + b.wifi + ' reload) >/dev/null 2>&1 &');
		const dflt = preinstallPw();
		if (rootRelease(sha256, dflt)) log(dflt ? 'root 密码改回出厂默认密码（预装）' : 'root 密码是跟着家长 WiFi 设的，已清空');
		return id;
	});
	if (r[1]) { log('解除绑定：拿不到锁'); return 1; }
	writeText(tmp('claim-from'), '' + mono());
	bumpGen();
	log('已解除绑定并清除数据，新编号 ' + r[0].code);
	return 0;
}

// 处理升级程序报到带回的收件箱
function checkinDue(id, t) {
	const ck = readJson(etc('checkin.json'), null), lt = localtime(t);
	if (!ck?.at || t - ck.at > 26 * 3600) return true;
	const spread = (ord(id.id, 0) * 256 + ord(id.id, 1)) % 14400, sec = lt.hour * 3600 + lt.min * 60 + lt.sec;
	return ck.day != today(lt) && sec >= 7200 + spread && sec < 6 * 3600;
}
function applyList(fn) { OPS.editParents(L => { fn(L); }); }
// 账号类动作（每日报到、同步回包共用）：远程解绑、加入凭证、待移除名单、会员凭证、
// 远程管理总开关、门铃开关。服务期外也照样处理，所以续期、接受邀请、移除家长、远程解绑都能马上生效；解绑了返回 true
function accountApply(id, r, src) {
	const opt = { now: r.now, clockOk: true };
	if (r.wipe) { log('家长远程解除了绑定'); unbind(true); return true; }
	for (let cred in (r.joins ?? [])) {
		const v = verify(hmacSha256, id.key, cred, 'join', id.id, opt);
		if (v[0]) applyList(L => { const x = listJoin(L, v[0], '', now()); if (!x[1]) log(src + '带来的加入凭证已写入名单'); });
	}
	if (r.removes) {
		const v = verify(hmacSha256, id.key, r.removes, 'remove', id.id, opt);
		if (v[0]) applyList(L => { for (let o in v[0].o) if (!listRemove(L, o)[1]) log('按远程操作移除了一位家长'); });
	}
	memberSet(id, r.member, opt);
	if (r.remote != null) remoteFlag(!!r.remote);
	return false;
}
function applyCheckin(id, r) {
	if (accountApply(id, r, '报到')) return;
	if (r.noBackup) {
		bkLoad();
		bk.sentVer = 0; bk.dueAt = now(); writeJson(etc('backup.json'), bk);
	}
}
function inboxStep(id) {
	for (let f in sort(fs.lsdir(tmp('inbox')) ?? [])) {
		const x = readJson(tmp('inbox/' + f), null);
		fs.unlink(tmp('inbox/' + f));
		if (type(x?.now) == 'int') { applyCheckin(id, x); if (x.wipe) return; }
	}
}
function checkin(id, c) {
	const on = wifiState(wifiBins(), map(c.nets, n => n.key)) ?? {};
	const env = envSafe(), ac = readJson(etc('autocount.json'), null);
	let uv = '';
	try { uv = updaterVersion(); } catch (e) { uv = ''; }
	const r = call(id, 'checkin', { version: VERSION, updater: uv, lastUpgrade: 0, claimed: length(c.parents?.parents ?? []) > 0,
		kidNets: length(filter(keys(on), k => on[k])), memberUntil: c.member?.x ?? 0, haveCurrent: true, ...(env ? { env } : {}), ...(type(ac) == 'object' ? { auto: ac } : {}) });
	if (!r?.ok) { log('代升级程序报到没成功：' + (r?.error ?? '连不上云端或回包不对') + '，稍后再试'); return false; }
	const lt = localtime(now());
	writeJson(etc('checkin.json'), { day: today(lt), at: now() });
	applyCheckin(id, r);
	return true;
}

// ---------- 会员同步：状态上报、取命令、执行远程命令 ----------
// 服务期内同步有三种时机：关键状态变了就报；门铃响了（doti bell 收到云端的门铃）；每 30 分钟兜底一次。服务期外不连门铃，只在孩子查看页点刷新时问一次
let rm = { sent: null, sentKey: '', tags: null, tagsKey: '', due: 0, acks: [], fails: 0, next: 0, last: -99999, ring: false, lookAt: -99999, svc: null, histAt: 0 };
const POLL_GAP = 1800;
const LOOK_GAP = 30;   // 服务期外孩子查看页刷新最多 30 秒问一次云端（和按钮的冷却一样）
function memberOn(c) { return (c.member?.x ?? 0) > now(); }
function spread(id) { return (ord(id.id, 2) * 256 + ord(id.id, 3)) % 120; }

// 远程命令（ICD §4.4）：类型 → 执行，回 [state, result]。state：done / rejected / expired；和局域网接口共用 ops 的规则
// 执行一条远程命令，返回回报 { cmdId, state, result }；没法识别的返回 null。同一条执行过的照记下的回报
function execCmd(id, cmd, cloudNow) {
	const x = verify(hmacSha256, id.key, cmd, 'cmd', id.id, { clockOk: false })[0];   // 先只验签名，到期按云端时间单独判断
	if (type(x?.i) != 'string') return null;
	const rec = readJson(etc('cmds.json'), null), seen = doneOf(rec, x.i);
	if (seen) return { cmdId: x.i, state: seen.state, result: seen.result, old: true };
	const L = readJson(etc('parents.json'), null) ?? emptyList(), op = x.op ?? {};
	let r;
	if (type(x.e) != 'int' || x.e <= cloudNow) r = ['expired', {}];
	else if (!isParent(L, x.by)) r = ['rejected', { reason: 'not_parent' }];
	else r = OPS.cmd(op.type, op.args, { code: id.code, by: x.by, at: x.at, base: op.base, now: now() });
	const state = r[0], result = r[1];
	writeJson(etc('cmds.json'), remember(rec, { i: x.i, state, result }));
	log('远程命令 ' + (op.type ?? '?') + '：' + state);
	return { cmdId: x.i, state, result };
}

// 处理回包里的命令和加入凭证；有执行的返回 true（要重读配置、立即上报）
// 同步回包：先处理账号类动作；limited（服务期外、总开关关着）只有这些，本地会员副本以云端为准作废，不执行命令
function remoteReply(id, r) {
	if (accountApply(id, r, '同步')) return false;
	if (r.limited) { if (!r.member) memberDrop(); return false; }
	let did = false;
	for (let cmd in (r.commands ?? [])) {
		const a = execCmd(id, cmd, r.now);
		if (!a) continue;
		if (!a.old) did = true;
		delete a.old;
		push(rm.acks, a);
	}
	return did;
}

// 成功返回回包；没开通（NOT_MEMBER，本地会员作废、1 分钟内不再调）、总开关关了（REMOTE_OFF）返回 { error }，不算失败、不退避；其他失败返回 null
function remoteCall(id, op, body) {
	const r = call(id, op, body);
	if (r?.ok) { rm.fails = 0; return r; }
	if (r?.error == 'REMOTE_OFF') { remoteFlag(false); return { error: r.error }; }
	if (r?.error == 'NOT_MEMBER') { memberDrop(); rm.next = mono() + 60; return { error: r.error }; }
	retryFail(rm, mono(), 20, 600);
	return null;
}

// 上网记录交给云端（服务期内）：今天以前还没交的日子（最多 KEEP_DAYS 天）从早到晚一天一个请求，连同状态变化和那天用到的设备名交上去，
// 云端收下的就删本地文件。一天一个请求是为了请求不超过约 30KB：uclient-fetch 走 HTTPS 发 40KB 以上会卡到超时，几天合成一个交，
// 攒多了就再也交不上。有没交的每小时试一次；某天交不上就停下，30 分钟后从那天接着试
const HIST_GAP = 3600, HIST_RETRY = 1800;
function histStep(id, day, m) {
	if (m < rm.histAt) return;
	const files = usagePending(fs.lsdir(etc('usage')) ?? [], day);
	rm.histAt = m + HIST_GAP;
	if (!length(files)) return;
	const nameOf = devInfo(readJson(etc('baseline.json'), null)?.devs, readJson(tmp('devices.json'), null), readJson(etc('devnames.json'), null));
	let n = 0;
	for (let f in files) {
		const d = readJson(etc('usage/' + f), {}), nets = usageApi(d), date = substr(f, 0, 10), devices = {};
		for (let x in nets) for (let h in x.hours) for (let v in (h.devs ?? [])) devices[v.mac] ??= nameOf(v.mac);
		const r = remoteCall(id, 'history', { days: [{ date, networks: nets, events: d._ev ?? {} }], devices });
		if (!r?.ok) { rm.histAt = m + HIST_RETRY; log(sprintf('上网记录交给云端没成功（%s）：%s', date, r?.error ?? '网络不通或超时')); break; }
		for (let s in (r.saved ?? [])) fs.unlink(etc('usage/' + s + '.json'));
		if (!(date in (r.saved ?? []))) break;
		n++;
	}
	if (n) log(sprintf('上网记录交给云端：%d 天', n));
}

// 每圈一次；执行了命令返回 true
// 云端让马上检查升级（同步回包带 updNow：管理员发起的时间）：交给升级程序（写 /tmp/doti/upd.now，它几秒内看到就马上报到、
// 拿到新版本立即装）；同一次只交一回
function updNowSeen(r) {
	const v = r?.updNow;
	if (type(v) != 'int' || v <= 0 || trim(fs.readfile(tmp('upd.now')) ?? '') == '' + v) return;
	writeText(tmp('upd.now'), '' + v);
	log('云端让马上检查升级');
}

function remoteStep(id, c) {
	const look = takeMark('look');   // 孩子查看页点了刷新：服务期内不用（有门铃），服务期外问一次云端（续费后尽快生效）
	// 门铃响过就记着，直到真的同步了才算用掉；门铃能响说明云端通，不用等失败退避
	if (takeMark('bell')) rm.ring = true;
	if (!id.registered || !lastStatus) { rm.sent = null; rm.sentKey = ''; rm.tags = null; rm.tagsKey = ''; return false; }
	const t = now(), m = mono(), day = today(localtime(t)), poll = m - rm.last >= POLL_GAP, ring = rm.ring;
	// 服务期外、总开关关着：不报状态、不定时同步（每日报到兜底），只在门铃响时问一下云端拿账号类动作（续期、邀请、移除、解绑）；
	// 续上了就带回会员凭证，下一圈起照常同步
	const svc = remoteOn() && memberOn(c);
	if (svc !== rm.svc) {
		// 服务期到了：门铃断开，doti bell 之后不再连；续上了它 30 秒内自己连上
		if (rm.svc === true && !svc && !getenv('DOTI_MQTT_SUB')) system('killall mosquitto_sub 2>/dev/null');
		rm.svc = svc;
	}
	if (!svc) {
		rm.sent = null; rm.sentKey = ''; rm.tags = null; rm.tagsKey = '';
		// 服务期外不连门铃、不定时同步；孩子查看页点了刷新（和按钮一样 30 秒最多一次）才问一次云端拿账号类动作
		const kid = look && m - rm.lookAt >= LOOK_GAP;
		if (!ring && !kid) return false;
		if (kid) rm.lookAt = m;
		rm.last = m; rm.ring = false;
		const r = remoteCall(id, 'sync', {});
		if (!r?.ok) return false;
		if (!r.limited) log('云端说远程管理已开通（门铃）');
		return remoteReply(id, r);
	}
	histStep(id, day, m);
	// 门铃响了也一起报状态（家长点「☁ 远程」刷新时云端只是按门铃，路由器马上报最新的）
	// 各 WiFi 密码改动时间：兜底同步时按密码摘要核一遍（LuCI 等别处改的也能发现），平时读记录（改密码时已记）
	const pwAt = poll || ring ? OPS.pwStamp(id.code, t) : OPS.pwAtOf();
	const ks = keyState(lastStatus, c.settings, day, pwAt), kstr = sprintf('%J', ks), force = takeMark('report') || ring;
	const tstr = sprintf('%J', lastSnap?.tags);
	if (force) rm.due = m;
	else if (kstr != rm.sentKey && !rm.due) rm.due = remoteUrgent(rm.sent, ks) ? m : m + spread(id);
	else if (tstr != rm.tagsKey && !rm.due) rm.due = m;   // 家人、WiFi 名字这些变了：马上报
	if (!retryDue(rm, m) && !ring) return false;
	// 一次同步（sync）：该报了就带 status（设置版本变了才带 settings），有回执就带 acks；门铃响了、到了兜底时间就算都没有也调
	const report = !!(rm.due && m >= rm.due);
	if (!report && !length(rm.acks) && !ring && !poll) return false;
	const body = {}, acks = rm.acks;
	// 快照只报云端手里没有的段（rm.tags 是上次报成功的摘要）
	if (report && lastSnap) body.snap = snapshotReport(lastSnap, rm.tags);
	if (length(acks)) body.acks = acks;
	rm.acks = []; rm.last = m; rm.ring = false;
	const r = remoteCall(id, 'sync', body);
	if (!r?.ok) { rm.acks = acks; return false; }
	updNowSeen(r);
	if (report) { rm.sent = ks; rm.sentKey = kstr; rm.due = 0; if (body.snap) { rm.tags = body.snap.tags; rm.tagsKey = tstr; } }
	if (r.needSettings) { rm.tags = null; rm.due = m; }   // 云端没存过（新开通、被清理过）：下一次整份报
	let did = remoteReply(id, r);
	if (did) rm.due = m;
	return did;
}

// 升级程序的看护（它负责每日报到，它出问题云端就收不到这台）：
// 没装上 → 每 6 小时在后台补装一次（updater-fix，开机时服务启动已经补过一轮）；
// 装着但 3 天没报到成功（服务停了、在用的副本坏了）→ 改用出厂副本、重启升级程序服务（每天最多一次）。
// 这两种情况返回 false，管控程序自己每天报到一次，云端不会失联
const UPD_FIX_GAP = 6 * 3600, UPD_STALE = 3 * 86400;
let updFrom = null, updFixAt = null, updKickAt = null;
function updaterOk(m) {
	if (updFrom == null) { updFrom = m - +(getenv('DOTI_UPD_AGE') || 0); updFixAt = updFrom; }   // DOTI_UPD_AGE：测试用，当作已经看了这么多秒
	if (!exists(cfg.updater)) {
		if (m - updFixAt >= UPD_FIX_GAP) {
			updFixAt = m;
			log('升级程序没装上，后台再试着补装');
			system(sprintf('%s 3 >/dev/null 2>&1 </dev/null &', shq(cfg.updFix)));
		}
		return false;
	}
	const at = readJson(cfg.updDir + '/checkin.json', null)?.at ?? 0;
	if (now() - at <= UPD_STALE || m - updFrom <= UPD_STALE) return true;
	if (updKickAt == null || m - updKickAt >= 86400) {
		updKickAt = m;
		const act = trim(fs.readfile(cfg.updDir + '/active') ?? '');
		if (act) fs.unlink(cfg.updDir + '/active');
		log('升级程序 3 天没报到成功，' + (act ? '改用出厂副本、' : '') + '重启升级程序；这期间由管控程序每天报到');
		system(sprintf('%s enable >/dev/null 2>&1; %s restart >/dev/null 2>&1 </dev/null', shq(cfg.updInitd), shq(cfg.updInitd)));
	}
	return false;
}

function cloudStep(id, c) {
	if (takeMark('unregistered')) lostRegistration(id);
	const m = mono(), want = takeMark('register');
	if (!id.registered) {
		if (retryDue(regRetry, m) || (want && m - regLast >= 30)) {
			regLast = m;
			// 身份还没写进闪存：先补写，写不进去就先不登记
			if (id.unsaved) {
				delete id.unsaved;
				if (!writeSecret(etc('identity.json'), id)) { id.unsaved = true; retryFail(regRetry, m, 60, 3600); return; }
				log('设备身份已写进闪存');
			}
			if (register(id)) retryOk(regRetry);
			else retryFail(regRetry, m, 60, 3600);
		}
		return;
	}
	// 已登记但云端可能没有硬件指纹（老版本没取到 / 没记过带了什么）：再登记一次（同一身份重复登记没关系，云端只补不改）
	if (id.hw != hwHash() && retryDue(regRetry, m)) {
		if (register(id, true)) retryOk(regRetry);
		else retryFail(regRetry, m, 60, 3600);
	}
	inboxStep(id);
	if (!updaterOk(m) && retryDue(ckRetry, m) && checkinDue(id, now())) {
		if (checkin(id, c)) retryOk(ckRetry);
		else retryFail(ckRetry, m, 60, 3600);
		return;
	}
	takeMark('backup');
	backupMark(id, c);
	if (bk.ver > bk.sentVer && now() >= bk.dueAt && retryDue(bk, m)) backupUpload(id, c);
}

// 基本状态（路由器管理页 LuCI 只读显示用）：不含设备 ID、密钥、密码（rootTemp 是公开的临时默认密码，正在用时才带）
function info() {
	const id = readJson(etc('identity.json'), null) ?? {}, st = fs.stat(tmp('status.json'));
	const u = updRecords(), ck = u.ck, up = u.up;
	return { version: VERSION, released: trim(fs.readfile('/usr/share/doti/released') ?? ''), updater: updaterVersion(), running: exists(tmp('running')) && !!st && now() - st.mtime < 90,
		code: id.code ?? '', registered: !!id.registered, parents: length(readJson(etc('parents.json'), null)?.parents ?? []), kidNets: length(nets()),
		parentWifi: adminSsid(id.code), lastCheckin: ck?.at ?? 0, rootTemp: rootKind(sha256) == 'temp' ? ROOT_TEMP_PW : '',
		...(up ? { lastUpgrade: { from: up.prev, to: up.to, result: up.result, reason: up.reason ?? '', at: up.at } } : {}) };
}

// ---------- 命令 ----------
function run() {
	ensureDirs();
	fs.unlink(tmp('off'));
	writeText(tmp('running'), '1');
	let id = identity();
	let c = loadConf(id);
	if (!length(c.nets)) { log('没有孩子网络（/etc/doti/nets.json），退出'); return 1; }
	writeAddr(c);
	// 硬件指纹（出厂 MAC 的哈希，重刷不变）：发现接口带上，家长手机认出是不是以前那台（恢复用）
	const hw = hwHash();
	if (hw) writeText(tmp('hw'), hw);
	baseApply(c);
	st = readJson(tmp('state.json'), null) ?? readJson(etc('state.json'), {});
	det = detCreate(readJson(etc('baseline.json'), null));
	lastBaseSave = mono();
	let nextTick = 0, nextRrm = mono() + 30, seen = gen(), cloudErr = '', cloudErrAt = -1e9;
	// 开机先用上次云端告诉的
	freeIps = freeIpList({ freeIps: split(trim(fs.readfile(etc('free-ips')) ?? ''), '\n') });
	setApplied(seen);
	log('启动 ' + VERSION + '，编号 ' + id.code);
	while (!exists(tmp('off'))) {
		const m = mono(), g = gen();
		if (g != seen) {
			id = identity();
			c = loadConf(id);
			tick(id, c);
			nextTick = mono() + TICK;
			setApplied(g);
			seen = g;
		}
		else if (m >= nextTick) { tick(id, c); nextTick = m + TICK; }
		// 云端这一步出任何错都不影响管控（同样的错 10 分钟只记一次日志），下一圈照常再试
		try { cloudStep(id, c); }
		catch (e) { const s = '' + e; if (s != cloudErr || m - cloudErrAt >= 600) { cloudErr = s; cloudErrAt = m; log('云端这一步出错：' + s); } }
		baseApply(c);   // 不限速地址变了马上生效（规则没变时 baseApply 什么都不做）
		claimStep(id);
		rootStep(id);
		if (remoteStep(id, c)) { seen = -1; nextTick = 0; }
		if (m >= nextRrm || (rrmAt && m >= rrmAt)) { rrmAt = 0; nextRrm = m + (rrmSync() ? REAPPLY : 60); }
		if (getenv('DOTI_ONCE')) break;
		if (vclock != null) { vclock++; if (--loops <= 0) break; continue; }
		sleep(1000);
	}
	saveBaseline();
	usageSave();
	writeJson(etc('state.json'), st);
	fs.unlink(tmp('running'));
	return 0;
}

// 门铃：procd 常驻 `doti bell`，订阅这台路由器的门铃主题（由设备密钥派生，和云端 C.bellTopic 一样），
// 收到就写 bell 标记，管控程序下一圈（1 秒内）去同步。门铃只是空消息；连不上 30 秒后重连，期间靠 30 分钟兜底同步。
// 只在服务期内连（bellWant）；服务期到了管控程序把它断开，续上了这里 30 秒内自己连上
function bellHost() {
	const e = getenv('DOTI_BELL_HOST') || trim(fs.readfile('/usr/share/doti/bell') ?? '');
	return e || cloudHost();
}
function bell() {
	ensureDirs();
	// procd 重启门铃只杀这个进程，popen 起的 mosquitto_sub 会留下来；同一个客户端 ID 两个连接会互相顶下线，先清掉
	if (!getenv('DOTI_MQTT_SUB')) system('killall mosquitto_sub 2>/dev/null');
	for (;;) {
		const id = identity(), host = bellHost();
		if (id?.registered && id?.key && host && bellWant()) {
			const topic = 'doti/n/' + substr(hmacSha256(id.key, 'doti1|bell'), 0, 16);
			const p = fs.popen(sprintf("%s -h '%s' -p 1883 -t '%s' -k 120 -q 0 -i 'doti-%s' 2>/dev/null", getenv('DOTI_MQTT_SUB') || 'mosquitto_sub', host, topic, id.id), 'r');
			if (p) {
				for (let l = p.read('line'); l != null && l != ''; l = p.read('line')) writeText(tmp('bell.now'), '1');
				p.close();
			}
		}
		if (getenv('DOTI_ONCE')) return 0;
		sleep(30000);
	}
}

function stop() {
	ensureDirs();
	writeText(tmp('off'), '1');
	for (let i = 0; i < 30 && exists(tmp('running')); i++) sleep(100);
	nftApply(cfg.nft, tmp('off.nft'), removeAll);
	log('管控已停止');
	return 0;
}

// 卸载前尽力告诉云端一声（主程序包卸载脚本里调，限时几秒，失败不影响卸载）：
// 已登记才发；升级程序正在装包（拿着它的锁）说明是升级不是卸载，不发
function bye() {
	const id = readJson(etc('identity.json'), null);
	if (!id?.registered || !id?.key || !id?.id) return 0;
	if (exists((getenv('DOTI_UPD_TMP') || '/tmp') + '/doti-updater.lock')) return 0;
	const r = cloudPost(hmacSha256, id, 'uninstall', now(), {}, '/tmp');
	log(r?.ok ? '卸载：已告诉云端' : '卸载：没连上云端，照样卸载');
	return 0;
}

const cmd = ARGV[0];
if (cmd == 'run') exit(run());
else if (cmd == 'init') { ensureDirs(); print(identity().code + '\n'); exit(0); }
else if (cmd == 'id') { print(identity().id + '\n'); exit(0); }
else if (cmd == 'info') { print(sprintf('%J\n', info())); exit(0); }
else if (cmd == 'status') { print(sprintf('%J\n', readJson(tmp('status.json'), {}))); exit(0); }
else if (cmd == 'stop') exit(stop());
else if (cmd == 'bell') exit(bell());
else if (cmd == 'unbind') exit(unbind(ARGV[1] == '--remote'));
else if (cmd == 'bye') exit(bye());
else { warn('用法：doti run | init | id | status | stop | bell | unbind | bye\n'); exit(2); }
